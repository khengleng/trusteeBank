# Cambobia Trustee Banking Platform — environment template.
# On Railway, set these as service variables. Never commit real secrets (§27).
# Private services reference Postgres/Redis via Railway private networking.

# --- Runtime ---
NODE_ENV=production
PORT=3000
SWAGGER_ENABLED=false          # keep internal /bank routes out of public docs (domain config)

# --- Database (Railway Postgres plugin provides DATABASE_URL) ---
# DATABASE_URL="${{ Postgres.DATABASE_URL }}"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustee?schema=public"

# --- Redis (queues/locks; Railway Redis plugin) ---
# REDIS_URL="${{ Redis.REDIS_URL }}"
REDIS_URL="redis://localhost:6379"

# --- Trustee platform domains (domain config; no hard-coding in business logic) ---
TRUSTEE_PUBLIC_URL=https://trustee.cambobia.com
TRUSTEE_API_URL=https://api.trustee.cambobia.com
TRUSTEE_OPS_URL=https://ops.trustee.cambobia.com
TRUSTEE_TREASURY_URL=https://treasury.trustee.cambobia.com
TRUSTEE_COMPLIANCE_URL=https://compliance.trustee.cambobia.com
TRUSTEE_AUDIT_URL=https://audit.trustee.cambobia.com

# --- External client platforms (already deployed) ---
PAYCHAIN_PUBLIC_URL=https://paychain.cambobia.com
PAYCHAIN_API_URL=https://api.paychain.cambobia.com
PAYKH_PUBLIC_URL=https://paykh.cambobia.com
PAYKH_API_URL=https://api.paykh.cambobia.com

# --- CORS: approved origins only, comma-separated (never *) ---
# CORS_ALLOWED_ORIGINS=https://trustee.cambobia.com,https://ops.trustee.cambobia.com,https://paychain.cambobia.com,https://paykh.cambobia.com

# --- Mint guard staleness tolerances (seconds) ---
MAX_RESERVE_SNAPSHOT_AGE_S=900
MAX_BANK_CONNECTIVITY_AGE_S=300
MAX_LIABILITY_FEED_AGE_S=900
MINT_AUTH_TTL_S=900

# --- Signature verification of the PayChain liability feed (§15) ---
# Register PayChain's public key so liability snapshots are independently verified.
# PAYCHAIN_LIABILITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# --- Worker ---
WORKER_INTERVAL_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BATCH_SIZE=25

# --- Client credentials (pilot) ---
# Deterministic pilot secrets are derived from this salt; rotate for production.
CLIENT_SECRET_SALT=cambobia-trustee-pilot

# --- Email notifications (Resend) — §30 stakeholder notifications ---
# RESEND_API_KEY=re_xxx
NOTIFY_FROM="Cambobia Trustee <contact@cambobia.com>"
NOTIFY_TO=contact@cambobia.com

# --- AI (OpenAI) — reserved for transaction-monitoring / adverse-media ---
# OPENAI_API_KEY=sk-xxx

# --- Signing keys (§38): production loads KMS/HSM-backed keys, NOT these.
# Dev generates ephemeral in-memory keys. Do not put production private keys here.
