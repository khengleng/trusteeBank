{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/trustee-api/Dockerfile"
  },
  "deploy": {
    "startCommand": "sh -c \"npx prisma migrate deploy --schema packages/database/prisma/schema.prisma && node apps/trustee-api/dist/main.js\"",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 2
  }
}
